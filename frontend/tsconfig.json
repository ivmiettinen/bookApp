{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx"
  },
  "include": ["src"],
  "exclude": [
    "src/**/*.test.*",
    "src/**/*.spec.*",
    "src/**/__tests__/**",
    "src/**/__mocks__/**",
    "src/setupTests.*",
    "src/test-utils.*"
  ]
}
